`timescale 1ns/1ps
module tb_seq_mult_8x8;

  reg clk, rst_n, start;
  reg [7:0] a, b;
    wire [15:0] product;

    // Instantiate DUT
    seq_mult_8x8 uut (
        .clk(clk),
        .rst_n(rst_n),
        .start(start),
        .a(a),
        .b(b),
        .product(product)
    );

    // Clock generation (10ns period = 100 MHz)
    always #5 clk = ~clk;

    initial begin
        // Enable waveform dump
        $dumpfile("seq_mult_8x8.vcd");   // VCD file
        $dumpvars(0, tb_seq_mult_8x8);   // Dump all signals in this module

        // Initialize signals
        clk = 0;
        rst_n = 0;
        start = 0;
        a = 0;
        b = 0;

        // Apply reset
        #10 rst_n = 1;

        // Test 1: 5 × 3 = 15
        #10 a = 8'd5; b = 8'd3; start = 1;
        #10 start = 0;
        #100;
        $display("Test1: %d x %d = %d (Product = %d)", a, b, a*b, product);

        // Test 2: 12 × 10 = 120
        #10 a = 8'd12; b = 8'd10; start = 1;
        #10 start = 0;
        #100;
        $display("Test2: %d x %d = %d (Product = %d)", a, b, a*b, product);
        // Test 3: 25 × 7 = 175
        #10 a = 8'd25; b = 8'd7; start = 1;
        #10 start = 0;
        #100;
        $display("Test3: %d x %d = %d (Product = %d)", a, b, a*b, product);
        $finish;
    end
endmodule
